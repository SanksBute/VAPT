// SentinelX AI — Complete Prisma Schema
// Enterprise AI-Powered Offensive Security Platform
// Version: 1.0.0

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "fullTextSearch", "metrics"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, pg_trgm, pgvector(map: "vector"), uuid_ossp(map: "uuid-ossp")]
}

// ============================================================
// ENUMS
// ============================================================

