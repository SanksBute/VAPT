// ============================================================
// ORGANIZATION & TENANCY
// ============================================================

model Organization {
  id                    String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                  String      @unique @db.VarChar(100)
  name                  String      @db.VarChar(255)
  displayName           String?     @db.VarChar(255)
  logoUrl               String?     @db.VarChar(2048)
  faviconUrl            String?     @db.VarChar(2048)
  primaryColor          String?     @db.VarChar(7)
  secondaryColor        String?     @db.VarChar(7)
  domain                String?     @unique @db.VarChar(255)
  allowedEmailDomains   String[]    @default([])
  status                OrgStatus   @default(ACTIVE)
  tier                  OrgTier     @default(STARTER)
  isWhiteLabel          Boolean     @default(false)
  whiteLabelConfig      Json?
  settings              Json        @default("{}")
  metadata              Json        @default("{}")
  maxUsers              Int         @default(10)
  maxAssets             Int         @default(100)
  maxScansPerMonth      Int         @default(10)
  enabledFeatures       String[]    @default([])
  ssoEnabled            Boolean     @default(false)
  ssoConfig             Json?
  mfaRequired           Boolean     @default(false)
  ipWhitelist           String[]    @default([])
  dataRetentionDays     Int         @default(365)
  timezone              String      @default("UTC") @db.VarChar(100)
  country               String?     @db.VarChar(2)
  address               Json?
  billingEmail          String?     @db.VarChar(255)
  technicalEmail        String?     @db.VarChar(255)
  securityEmail         String?     @db.VarChar(255)
  version               Int         @default(1)
  deletedAt             DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  // Relations
  users                 OrganizationMember[]
  assets                Asset[]
  scans                 Scan[]
  vulnerabilities       Vulnerability[]
  reports               Report[]
  tickets               Ticket[]
  apiKeys               ApiKey[]
  integrations          Integration[]
  webhooks              Webhook[]
  notifications         Notification[]
  auditLogs             AuditLog[]
  subscription          Subscription?
  complianceProfiles    ComplianceProfile[]
  riskProfiles          RiskProfile[]
  scanSchedules         ScanSchedule[]
  tags                  Tag[]
  customFields          CustomField[]
  pluginInstallations   PluginInstallation[]
  threatIntelFeeds      ThreatIntelFeed[]
  cloudConnections      CloudConnection[]
  aiConversations       AIConversation[]
  dashboards            Dashboard[]
  invitations           Invitation[]
  projects              Project[]
  assetGroups           AssetGroup[]

  @@index([slug])
  @@index([domain])
  @@index([status])
  @@index([tier])
  @@index([deletedAt])
  @@map("organizations")
}

model OrganizationMember {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String     @db.Uuid
  userId         String     @db.Uuid
  role           UserRole   @default(VIEWER)
  customRoleId   String?    @db.Uuid
  permissions    String[]   @default([])
  isOwner        Boolean    @default(false)
  joinedAt       DateTime   @default(now())
  invitedBy      String?    @db.Uuid
  lastActiveAt   DateTime?
  deletedAt      DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])
  customRole     CustomRole?  @relation(fields: [customRoleId], references: [id])

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([role])
  @@index([deletedAt])
  @@map("organization_members")
}

model Invitation {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @db.Uuid
  email          String    @db.VarChar(255)
  role           UserRole  @default(VIEWER)
  token          String    @unique @db.VarChar(255)
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  invitedById    String    @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  invitedBy      User         @relation(fields: [invitedById], references: [id])

  @@index([organizationId])
  @@index([email])
  @@index([token])
  @@index([expiresAt])
  @@map("invitations")
}

// ============================================================
// USERS & AUTHENTICATION
// ============================================================

model User {
  id                  String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email               String      @unique @db.VarChar(255)
  emailVerified       Boolean     @default(false)
  emailVerifiedAt     DateTime?
  passwordHash        String?     @db.VarChar(255)
  firstName           String      @db.VarChar(100)
  lastName            String      @db.VarChar(100)
  displayName         String?     @db.VarChar(200)
  avatarUrl           String?     @db.VarChar(2048)
  phone               String?     @db.VarChar(50)
  phoneVerified       Boolean     @default(false)
  timezone            String      @default("UTC") @db.VarChar(100)
  locale              String      @default("en") @db.VarChar(10)
  theme               String      @default("dark") @db.VarChar(20)
  status              UserStatus  @default(PENDING_VERIFICATION)
  isSuperAdmin        Boolean     @default(false)
  isServiceAccount    Boolean     @default(false)
  mfaEnabled          Boolean     @default(false)
  mfaEnforcedAt       DateTime?
  lastLoginAt         DateTime?
  lastLoginIp         String?     @db.VarChar(50)
  loginCount          Int         @default(0)
  failedLoginCount    Int         @default(0)
  lockedUntil         DateTime?
  passwordChangedAt   DateTime?
  mustChangePassword  Boolean     @default(false)
  preferences         Json        @default("{}")
  metadata            Json        @default("{}")
  version             Int         @default(1)
  deletedAt           DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  // Relations
  organizations       OrganizationMember[]
  sessions            UserSession[]
  mfaMethods          MfaDevice[]
  apiKeys             ApiKey[]
  oauthAccounts       OAuthAccount[]
  emailVerifications  EmailVerification[]
  passwordResets      PasswordReset[]
  auditLogs           AuditLog[]
  assignedTickets     Ticket[]           @relation("TicketAssignee")
  createdTickets      Ticket[]           @relation("TicketCreator")
  reports             Report[]
  aiConversations     AIConversation[]
  invitations         Invitation[]
  notificationPrefs   NotificationPreference[]
  dashboards          Dashboard[]

  @@index([email])
  @@index([status])
  @@index([deletedAt])
  @@index([isSuperAdmin])
  @@map("users")
}

model UserSession {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @db.Uuid
  tokenHash    String    @unique @db.VarChar(255)
  refreshTokenHash String? @unique @db.VarChar(255)
  deviceInfo   Json      @default("{}")
  ipAddress    String    @db.VarChar(50)
  userAgent    String?   @db.VarChar(512)
  geolocation  Json?
  isActive     Boolean   @default(true)
  revokedAt    DateTime?
  expiresAt    DateTime
  lastSeenAt   DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@index([isActive])
  @@map("user_sessions")
}

model MfaDevice {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @db.Uuid
  method      MfaMethod
  name        String    @db.VarChar(100)
  secret      String?   @db.VarChar(255)
  phoneNumber String?   @db.VarChar(50)
  backupCodes Json?
  isVerified  Boolean   @default(false)
  isPrimary   Boolean   @default(false)
  lastUsedAt  DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([method])
  @@map("mfa_devices")
}

model OAuthAccount {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @db.Uuid
  provider       String   @db.VarChar(50)
  providerUserId String   @db.VarChar(255)
  accessToken    String?  @db.VarChar(4096)
  refreshToken   String?  @db.VarChar(4096)
  expiresAt      DateTime?
  scope          String?  @db.VarChar(1024)
  profile        Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("oauth_accounts")
}

model EmailVerification {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique @db.VarChar(255)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("email_verifications")
}

model PasswordReset {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique @db.VarChar(255)
  expiresAt DateTime
  usedAt    DateTime?
  ipAddress String?  @db.VarChar(50)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

model ApiKey {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @db.Uuid
  userId         String    @db.Uuid
  name           String    @db.VarChar(255)
  keyHash        String    @unique @db.VarChar(255)
  keyPrefix      String    @db.VarChar(10)
  scopes         String[]  @default([])
  allowedIps     String[]  @default([])
  lastUsedAt     DateTime?
  lastUsedIp     String?   @db.VarChar(50)
  expiresAt      DateTime?
  revokedAt      DateTime?
  usageCount     Int       @default(0)
  rateLimitRpm   Int       @default(100)
  metadata       Json      @default("{}")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([userId])
  @@index([keyHash])
  @@index([expiresAt])
  @@map("api_keys")
}

model CustomRole {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @db.Uuid
  name           String    @db.VarChar(100)
  description    String?   @db.VarChar(500)
  permissions    String[]  @default([])
  isSystemRole   Boolean   @default(false)
  parentRoleId   String?   @db.Uuid
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  members        OrganizationMember[]
  parentRole     CustomRole?  @relation("RoleHierarchy", fields: [parentRoleId], references: [id])
  childRoles     CustomRole[] @relation("RoleHierarchy")

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("custom_roles")
}

// ============================================================
// PROJECTS & ASSET GROUPS
// ============================================================

model Project {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @db.Uuid
  name           String    @db.VarChar(255)
  description    String?   @db.Text
  color          String?   @db.VarChar(7)
  icon           String?   @db.VarChar(50)
  isDefault      Boolean   @default(false)
  metadata       Json      @default("{}")
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  assets         Asset[]
  scans          Scan[]

  @@index([organizationId])
  @@index([deletedAt])
  @@map("projects")
}

model AssetGroup {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @db.Uuid
  name           String    @db.VarChar(255)
  description    String?   @db.Text
  query          Json?
  isDynamic      Boolean   @default(false)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  assets         AssetGroupMembership[]

  @@index([organizationId])
  @@index([deletedAt])
  @@map("asset_groups")
}

model AssetGroupMembership {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetGroupId String     @db.Uuid
  assetId      String     @db.Uuid
  createdAt    DateTime   @default(now())

  assetGroup   AssetGroup @relation(fields: [assetGroupId], references: [id], onDelete: Cascade)
  asset        Asset      @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetGroupId, assetId])
  @@map("asset_group_memberships")
}

// ============================================================
// ASSETS
// ============================================================

model Asset {
  id                    String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String           @db.Uuid
  projectId             String?          @db.Uuid
  name                  String           @db.VarChar(500)
  type                  AssetType
  status                AssetStatus      @default(ACTIVE)
  criticality           AssetCriticality @default(MEDIUM)
  identifier            String           @db.VarChar(500)
  hostname              String?          @db.VarChar(255)
  ipAddresses           String[]         @default([])
  macAddresses          String[]         @default([])
  fqdn                  String?          @db.VarChar(500)
  operatingSystem       String?          @db.VarChar(255)
  osVersion             String?          @db.VarChar(100)
  ports                 Json             @default("[]")
  services              Json             @default("[]")
  technologies          Json             @default("[]")
  cloudProvider         CloudProvider?
  cloudRegion           String?          @db.VarChar(100)
  cloudAccountId        String?          @db.VarChar(255)
  cloudResourceId       String?          @db.VarChar(500)
  cloudMetadata         Json?
  containerImage        String?          @db.VarChar(500)
  containerDigest       String?          @db.VarChar(255)
  kubernetesNamespace   String?          @db.VarChar(255)
  kubernetesCluster     String?          @db.VarChar(255)
  repositoryUrl         String?          @db.VarChar(2048)
  repositoryBranch      String?          @db.VarChar(255)
  owner                 String?          @db.VarChar(255)
  team                  String?          @db.VarChar(255)
  environment           String?          @db.VarChar(50)
  networkZone           String?          @db.VarChar(100)
  dataClassification    String?          @db.VarChar(50)
  complianceScope       String[]         @default([])
  riskScore             Float            @default(0)
  exposureScore         Float            @default(0)
  firstSeenAt           DateTime         @default(now())
  lastSeenAt            DateTime         @default(now())
  lastScannedAt         DateTime?
  attributes            Json             @default("{}")
  customFields          Json             @default("{}")
  notes                 String?          @db.Text
  version               Int              @default(1)
  deletedAt             DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  organization          Organization     @relation(fields: [organizationId], references: [id])
  project               Project?         @relation(fields: [projectId], references: [id])
  vulnerabilities       AssetVulnerability[]
  scans                 ScanTarget[]
  tags                  AssetTag[]
  groups                AssetGroupMembership[]
  history               AssetHistory[]
  ports_detail          AssetPort[]
  certificates          AssetCertificate[]
  technologies_detail   AssetTechnology[]

  @@unique([organizationId, identifier])
  @@index([organizationId])
  @@index([projectId])
  @@index([type])
  @@index([status])
  @@index([criticality])
  @@index([riskScore])
  @@index([deletedAt])
  @@index([lastSeenAt])
  @@map("assets")
}

model AssetHistory {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetId   String   @db.Uuid
  changes   Json
  changedBy String?  @db.Uuid
  reason    String?  @db.VarChar(500)
  version   Int
  createdAt DateTime @default(now())

  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([version])
  @@map("asset_history")
}

model AssetPort {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetId   String   @db.Uuid
  port      Int
  protocol  String   @db.VarChar(10)
  state     String   @db.VarChar(50)
  service   String?  @db.VarChar(100)
  version   String?  @db.VarChar(255)
  banner    String?  @db.Text
  firstSeen DateTime @default(now())
  lastSeen  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, port, protocol])
  @@index([assetId])
  @@index([port])
  @@map("asset_ports")
}

model AssetCertificate {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetId        String    @db.Uuid
