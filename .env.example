# SentinelX AI — Environment Configuration Template
# Copy to .env and fill in all values before running
# NEVER commit the actual .env file to version control

# ─── Application ─────────────────────────────────────────────
NODE_ENV=development
PORT=3001
API_VERSION=v1
API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql://sentinelx:sentinelx_dev_password@localhost:5432/sentinelx?schema=public
DATABASE_POOL_MAX=10
DATABASE_POOL_MIN=2

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://:sentinelx_redis_password@localhost:6379
REDIS_PASSWORD=sentinelx_redis_password
REDIS_TLS=false

# ─── RabbitMQ ────────────────────────────────────────────────
RABBITMQ_URL=amqp://sentinelx:sentinelx_rabbit_password@localhost:5672/sentinelx

# ─── OpenSearch ──────────────────────────────────────────────
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=

# ─── JWT Authentication ───────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX_SECRET_DO_NOT_USE_THIS_IN_PRODUCTION_EVER!!
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_CHAR_HEX_SECRET_FOR_REFRESH_TOKENS!!
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# ─── Encryption ──────────────────────────────────────────────
# Generate with: openssl rand -hex 32 (must be exactly 64 hex chars = 32 bytes)
ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHAR_ENCRYPTION_KEY_FOR_SENSITIVE_DATA_AES256
COOKIE_SECRET=REPLACE_WITH_AT_LEAST_32_CHARACTER_COOKIE_SECRET_STRING_HERE

# ─── OAuth2 (optional) ───────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ─── AI Providers ────────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
OLLAMA_BASE_URL=http://localhost:11434
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-02-01

# ─── Object Storage (MinIO) ──────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=sentinelx_minio
MINIO_SECRET_KEY=sentinelx_minio_password
MINIO_BUCKET=sentinelx
MINIO_USE_SSL=false

# ─── Email (SMTP) ────────────────────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SG.your_sendgrid_api_key
SMTP_FROM=noreply@sentinelx.io
SMTP_FROM_NAME=SentinelX AI

# ─── Billing (Stripe) ────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Notifications ───────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
PAGERDUTY_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── Observability ───────────────────────────────────────────
SENTRY_DSN=https://...@sentry.io/...
SENTRY_ENVIRONMENT=development
METRICS_PORT=9090

# ─── Rate Limiting ───────────────────────────────────────────
RATE_LIMIT_RPM=100
RATE_LIMIT_RPH=2000

# ─── Super Admin (for initial setup only) ────────────────────
SUPER_ADMIN_EMAIL=admin@sentinelx.io
SUPER_ADMIN_PASSWORD=CHANGE_THIS_IMMEDIATELY_AFTER_SETUP!

# ─── Feature Flags ───────────────────────────────────────────
ENABLE_AI_COPILOT=true
ENABLE_MARKETPLACE=true
ENABLE_CLOUD_SECURITY=true
ENABLE_KUBERNETES_SECURITY=true

# ─── Scanners (paths or Docker images) ───────────────────────
NMAP_BINARY=/usr/bin/nmap
NUCLEI_BINARY=/usr/local/bin/nuclei
TRIVY_BINARY=/usr/local/bin/trivy
SEMGREP_BINARY=/usr/local/bin/semgrep
USE_DOCKER_SCANNERS=false

# ─── Cloud Security ──────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# ─── Next.js Frontend ────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001
NEXT_PUBLIC_APP_NAME=SentinelX AI
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_APP_URL=http://localhost:3000
